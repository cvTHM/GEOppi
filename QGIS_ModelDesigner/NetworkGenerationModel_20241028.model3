  <Option name="groupBoxes"/>
  <Option name="help" type="Map">
    <Option value="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>This algorithm is used to generate a one-directional network topology which can be transferred to network calculation software.&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>Relevant inputs are a basic line layer which defines the course of network lines and buildings which shall be connected to the network and define the location of house connection lines (later used for defining mass flow sinks etc.).&lt;/p>&lt;/body>&lt;/html>" name="ALG_DESC" type="QString"/>
    <Option value="C. Völzel (29.04.2024)" name="ALG_HELP_CREATOR" type="QString"/>
    <Option name="SHORT_DESCRIPTION" type="invalid"/>
    <Option value="Mask (polygon) which is used to extract relevant geometries for &#xa;- BUILDINGS that shall be connected to the newly generated network,&#xa;- LINES representing the network  topology." name="buildingsmask" type="QString"/>
    <Option value="Buildings (geometries either polygons or points) from which a selection of buildings is taken that shall be connected to the network." name="buildingsraw" type="QString"/>
    <Option value="Selection from BuildingsRaw layer whiich are connected to the network. No filters are applied during this process!" name="buildingsselected_out" type="QString"/>
    <Option value="Line geometries from which the newly generated network shall be  cut." name="linesraw" type="QString"/>
    <Option value="Mask that shall be used for slsecting relevant geometries for&#xa;- LINEs represneting the newly generated network,&#xa;- BUILDINGS that shall be connected to the newly generated network." name="mask" type="QString"/>
    <Option value="Line layer with pure geometry information from LineString geometries and with continuous integers in field &quot;fid&quot; to enable saving as geopackage (.gpkg) file.&#xa;This layer can later be used in network calculation softwares." name="networkraw_out" type="QString"/>
  </Option>
